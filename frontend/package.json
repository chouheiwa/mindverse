{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/verify-build-boundaries.mjs ../web",
    "build:three": "VITE_RENDERER=three npm run build",
    "build:babylon": "VITE_RENDERER=babylon npm run build",
    "build:e2e": "tsc -b && tsc --noEmit -p tsconfig.e2e.json && MINDVERSE_BUILD_DIR=../.e2e-web VITE_E2E_DIAGNOSTICS=1 vite build && node scripts/verify-build-boundaries.mjs ../.e2e-web",
    "lint": "oxlint",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build:e2e && playwright test",
    "test:e2e:functional": "npm run build:e2e && playwright test --project=swiftshader-functional",
    "test:e2e:performance": "npm run build:e2e && playwright test --project=metal-performance",
    "test:e2e:install": "playwright install chromium",
    "preview": "vite preview"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "postprocessing": "^6.39.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^26.1.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
